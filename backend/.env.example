APP_NAME=GFF AI Backend
ENVIRONMENT=development
DEBUG=false
TESTING=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gff_ai
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-enterprise-platform-five.vercel.app,https://gffai.sg,https://www.gffai.sg,https://gffai.ai,https://www.gffai.ai
FRONTEND_URL=https://www.gffai.ai

AI_PROVIDER=openai
ENABLE_AI_MOCK_MODE=false
SECRET_KEY=replace-with-a-long-random-secret
GFF_PORTAL_JWT_SECRET=replace-with-a-second-long-random-secret
GFF_PORTAL_DEMO_PASSWORD=change-this-demo-password

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-nano
OPENAI_BLUEPRINT_MODEL=gpt-5.4-mini
BLUEPRINT_ENGINE_VERSION=v1
BLUEPRINT_DEFAULT_INDUSTRY=generic-enterprise

REDIS_URL=
EMAIL_PROVIDER=
RESEND_API_KEY=
STORAGE_PROVIDER=
S3_BUCKET=
CLOUDFLARE_R2_BUCKET=

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase -> Excel reporting sync (outbox -> Power Automate -> shared workbook).
# EXCEL_SYNC_WEBHOOK_URL/SECRET come from the Power Automate flow — never commit real values.
EXCEL_SYNC_ENABLED=false
EXCEL_SYNC_WEBHOOK_URL=
EXCEL_SYNC_WEBHOOK_SECRET=
EXCEL_SYNC_BATCH_SIZE=25
EXCEL_SYNC_MAX_ATTEMPTS=8
EXCEL_SYNC_POLL_SECONDS=30

# Daily website activity report (Supabase -> reporting query -> Resend email).
# RESEND_API_KEY is server-side only; never expose it to the frontend bundle.
# NOTE: verify ashish.chandra@gff.gffai.ai before go-live — "gff.gffai.ai"
# contains "gff" twice and may be a typo for ashish.chandra@gffai.ai.
REPORT_ENABLED=false
REPORT_RECIPIENTS=ashish.chandra@gff.gffai.ai,malvika.singh@gffai.ai
REPORT_FROM_EMAIL="GFF AI Reports <reports@gffai.ai>"
REPORT_TIMEZONE=Asia/Kolkata
REPORT_SEND_HOUR=23
REPORT_SEND_MINUTE=55
REPORT_MAX_ATTEMPTS=5
REPORT_POLL_SECONDS=60
DAILY_REPORT_SECRET=
REPORT_TEST_RECIPIENT=
ADMIN_DASHBOARD_URL=

# Analytics ingestion hardening.
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
ANALYTICS_PAYLOAD_MAX_BYTES=8192
