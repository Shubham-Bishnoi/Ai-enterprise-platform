APP_NAME=GFF AI Backend
ENVIRONMENT=production
DEBUG=false
TESTING=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://user:password@host:6543/postgres?sslmode=require
BACKEND_CORS_ORIGINS=https://your-vercel-domain.vercel.app
FRONTEND_URL=https://your-vercel-domain.vercel.app

AI_PROVIDER=openai
ENABLE_AI_MOCK_MODE=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-nano
OPENAI_BLUEPRINT_MODEL=gpt-5.4-mini

SECRET_KEY=
GFF_PORTAL_JWT_SECRET=
GFF_PORTAL_DEMO_PASSWORD=

BLUEPRINT_ENGINE_VERSION=v1
BLUEPRINT_DEFAULT_INDUSTRY=generic-enterprise

REDIS_URL=
EMAIL_PROVIDER=
RESEND_API_KEY=
STORAGE_PROVIDER=
S3_BUCKET=
CLOUDFLARE_R2_BUCKET=

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
